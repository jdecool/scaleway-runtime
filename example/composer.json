{
    "name": "jdecool/scaleway-runtime-example",
    "description": "Demo Symfony application running on Scaleway Serverless Functions",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.4",
        "jdecool/scaleway-runtime": "*@dev",
        "symfony/console": "^8.1",
        "symfony/dotenv": "^8.1",
        "symfony/framework-bundle": "^8.1",
        "symfony/runtime": "^8.1",
        "symfony/yaml": "^8.1"
    },
    "repositories": [
        {
            "type": "path",
            "url": ".."
        }
    ],
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "allow-plugins": {
            "symfony/runtime": true
        },
        "sort-packages": true
    }
}
