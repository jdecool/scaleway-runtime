{
    "name": "jdecool/scaleway-runtime-example",
    "description": "Demo Symfony application running on Scaleway Serverless Functions",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.4",
        "jdecool/scaleway-runtime": "dev-main",
        "symfony/console": "^8.1",
        "symfony/dotenv": "^8.1",
        "symfony/framework-bundle": "^8.1",
        "symfony/runtime": "^8.1",
        "symfony/yaml": "^8.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "allow-plugins": {
            "symfony/runtime": true
        },
        "sort-packages": true
    },
    "scripts": {
        "post-install-cmd": [
            "@php bin/console cache:warmup --env=prod"
        ],
        "link-runtime": [
            "@composer config repositories.local path ..",
            "@composer update jdecool/scaleway-runtime"
        ]
    },
    "scripts-descriptions": {
        "link-runtime": "Installs jdecool/scaleway-runtime from the parent directory: never commit the repository it adds"
    }
}
