{
    "name": "jdecool/scaleway-runtime",
    "description": "Symfony Runtime to run PHP applications on Scaleway Serverless Functions",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "symfony",
        "runtime",
        "scaleway",
        "serverless"
    ],
    "authors": [
        {
            "name": "Jérémy DECOOL",
            "email": "contact@jdecool.fr"
        }
    ],
    "require": {
        "php": ">=8.4",
        "composer/semver": "^3.4",
        "riverline/multipart-parser": "^2.3",
        "symfony/http-foundation": "^7.4 || ^8.0",
        "symfony/http-kernel": "^7.4 || ^8.0",
        "symfony/mime": "^7.4 || ^8.0",
        "symfony/runtime": "^7.4 || ^8.0"
    },
    "require-dev": {
        "ergebnis/composer-normalize": "^2.58",
        "friendsofphp/php-cs-fixer": "^3.95",
        "nyholm/psr7": "^1.8",
        "phpstan/phpstan": "^2.3",
        "phpstan/phpstan-phpunit": "^2.1",
        "phpunit/phpunit": "^13.4",
        "psr/http-server-handler": "^1.0",
        "symfony/console": "^7.4 || ^8.0",
        "symfony/dotenv": "^7.4 || ^8.0",
        "symfony/framework-bundle": "^7.4 || ^8.0",
        "symfony/psr-http-message-bridge": "^7.4 || ^8.0"
    },
    "suggest": {
        "ext-zip": "To build the deployment zip with vendor/bin/scaleway-package",
        "nyholm/psr7": "To run Front Controllers returning a PSR-15 request handler",
        "symfony/console": "To run Command Invocations and Front Controllers returning a Console Application or a Command",
        "symfony/psr-http-message-bridge": "To run Front Controllers returning a PSR-15 request handler"
    },
    "autoload": {
        "psr-4": {
            "JDecool\\ScalewayRuntime\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "JDecool\\ScalewayRuntime\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/scaleway-init",
        "bin/scaleway-package",
        "bin/scaleway-serve"
    ],
    "config": {
        "allow-plugins": {
            "ergebnis/composer-normalize": true,
            "symfony/runtime": false
        },
        "sort-packages": true
    },
    "scripts": {
        "check": [
            "@cs",
            "@phpstan",
            "@test"
        ],
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": "php-cs-fixer fix",
        "phpstan": "phpstan analyse",
        "test": "phpunit"
    }
}
