includes:
    - vendor/phpstan/phpstan-phpunit/extension.neon
    - vendor/phpstan/phpstan-phpunit/rules.neon

parameters:
    level: max
    paths:
        - src
        - tests
        - resources
        - bin/scaleway-doctor
        - bin/scaleway-init
        - bin/scaleway-package
        - bin/scaleway-serve
    excludePaths:
        # The stub users commit stays as short as possible, without annotations.
        - resources/handler.php
    scanFiles:
        - resources/handler.php
